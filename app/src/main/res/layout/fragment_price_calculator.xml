<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Price Calculator"
            android:textAppearance="@style/TextAppearance.NammaVastra.HeadlineMedium"
            android:textColor="?colorOnBackground"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Saree Type Dropdown -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_category"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Saree Type"
            app:layout_constraintTop_toBottomOf="@+id/tv_title">

            <AutoCompleteTextView
                android:id="@+id/actv_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:text="Silk" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Material Cost Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_cost"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Base Material Cost"
            app:prefixText="₹ "
            app:layout_constraintTop_toBottomOf="@+id/til_category">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_cost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Profit Margin Slider -->
        <TextView
            android:id="@+id/tv_margin_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Profit Margin"
            android:textAppearance="@style/TextAppearance.NammaVastra.TitleMedium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/til_cost" />

        <TextView
            android:id="@+id/tv_margin_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            tools:text="40%"
            android:textAppearance="@style/TextAppearance.NammaVastra.TitleMedium"
            android:textColor="?colorPrimary"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/til_cost" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_profit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:stepSize="5.0"
            android:valueFrom="10.0"
            android:valueTo="200.0"
            android:value="40.0"
            app:layout_constraintTop_toBottomOf="@+id/tv_margin_label" />

        <!-- Live Result Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_result"
            style="@style/Widget.Material3.CardView.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="?colorPrimaryContainer"
            app:cardCornerRadius="24dp"
            app:layout_constraintTop_toBottomOf="@+id/slider_profit">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tv_cost_lbl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Material Cost"
                    android:textColor="?colorOnPrimaryContainer"
                    android:alpha="0.7"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_result_cost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="₹ 0"
                    android:textColor="?colorOnPrimaryContainer"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_profit_lbl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Profit Amount"
                    android:textColor="?colorOnPrimaryContainer"
                    android:alpha="0.7"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_cost_lbl" />

                <TextView
                    android:id="@+id/tv_result_profit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    tools:text="+ ₹ 0"
                    android:textColor="?colorPrimary"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_result_cost" />

                <View
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="?colorOnPrimaryContainer"
                    android:alpha="0.2"
                    app:layout_constraintTop_toBottomOf="@+id/tv_profit_lbl" />

                <TextView
                    android:id="@+id/tv_suggested_lbl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Suggested Price"
                    android:textAppearance="@style/TextAppearance.NammaVastra.TitleMedium"
                    android:textColor="?colorOnPrimaryContainer"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/divider" />

                <TextView
                    android:id="@+id/tv_result_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    tools:text="₹ 0"
                    android:textAppearance="@style/TextAppearance.NammaVastra.HeadlineLarge"
                    android:textColor="?colorOnPrimaryContainer"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/divider" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Market Comparison -->
        <TextView
            android:id="@+id/tv_market_comparison"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            tools:text="Enter cost to see market comparison"
            android:textAppearance="@style/TextAppearance.NammaVastra.BodyMedium"
            android:textColor="?colorSecondary"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_result" />

        <!-- Save Button -->
        <Button
            android:id="@+id/btn_save_calc"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:text="Save Calculation"
            app:layout_constraintTop_toBottomOf="@+id/tv_market_comparison" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
