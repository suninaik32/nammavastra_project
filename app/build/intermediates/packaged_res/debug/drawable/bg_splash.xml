<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Magenta Color -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/md_theme_light_primary"/>
        </shape>
    </item>
    
    <!-- Gradient overlay to simulate silk shine -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#33FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#44000000"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#11FFFFFF"
                android:centerColor="#22000000"
                android:endColor="#33FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
